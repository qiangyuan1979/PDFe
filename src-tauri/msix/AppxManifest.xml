<?xml version="1.0" encoding="utf-8"?>
<!--
  PDFe MSIX 包装清单（full-trust Win32 应用）

  下方 XML 属性值中的五个占位符由 scripts/build-msix.ps1 在打包时替换。
  此处不写出占位符字面量，否则打包后的注释会被一并替换成值、读起来自相矛盾。
  - 包标识名（Identity 的 Name）—— Partner Center「产品标识 → 包/标识/名称」
    （形如 12345KonnyYuan.PDFe），以 -IdentityName 注入；本地侧载测试用脚本
    默认值 konnyyuan.pdfe。
  - 发布者（Identity 的 Publisher）—— 必须与签名证书 Subject 完全一致，否则
    Add-AppxPackage 报「清单中的 Publisher 与签名证书不匹配」。上架用 Partner
    Center「包/标识/发布者」（形如 CN=d9e5f0b8-...），以 -Publisher 注入。
  - 发布者显示名称（PublisherDisplayName）—— Partner Center「包/属性/发布者显示名称」，
    以 -PublisherDisplayName 注入。
  - 版本（Version）—— 取自 src-tauri/tauri.conf.json 的 version，补齐为四段（x.y.z.0）。
  - 可执行文件（Executable）—— 取自 tauri.conf.json 的 productName，与暂存进包的
    可执行文件名保持一致。

  本地自签名侧载测试用脚本默认值即可；上架 Microsoft Store 时必须换成 Partner Center
  分配的产品标识值（见 docs-internal/store-listing-materials.md §4）。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="__IDENTITY_NAME__"
    Publisher="__PUBLISHER__"
    Version="__VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>PDFe</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY_NAME__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>轻量 PDF 阅读与编辑工具</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.17763.0"
      MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-CN" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="__EXE__" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="PDFe"
        Description="轻量 PDF 阅读与编辑工具"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- 全信任桌面应用必需：允许以用户完整令牌运行 Win32 代码 -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
